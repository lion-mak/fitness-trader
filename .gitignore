# 数据工程源码（非站点运行时所需，仅本地构建 foods.json 用）
build/
*.pyc
__pycache__/

# 依赖
node_modules/

# 本地环境 / 编辑器
.workbuddy/
.vscode/

# 日志
*.log
_demo.html
promo/raw_*.png
promo/_edgeprofile*/
# 状态迁移回归测试的中间产物（state_test.py 生成，无需入库）
promo/_*.js
# 调试/清理用的临时脚本（一次性的像素水印清理、核验脚本等，不入仓）
promo/_*.py
promo/_*.css
promo/_*.txt
# 端到端验收测试的临时页与浏览器 profile（e2e_test.py 生成）
_e2e.html
promo/_e2eprofile*/
# 小程序调试用的本机中间产物（开发者工具 asar 抽取物 / 其缓存快照 / 探针回滚快照）
# 都是一次性、可再生、且体积大（_cache_backup 约 1 MB），不入仓
promo/_asar/
promo/_cache_backup/
promo/_probe_backup/
# 宣传图/截图成品与可再生的中间数据（体积大，随时可用脚本重跑）
promo/*.png
promo/*.json
# 对拍用的截图与对照页（随时可用 mp_auto_shot.js / mp_rect_*.py 重跑）
promo/_shots/
# 段位卡素材：v4 那批（像素搞怪·脏惨风）已被 Mak 否掉 —— 改由他从外部出图后替换
# ⚠️ 新图就位后**删掉下面两行**让素材入库：生图有随机性，源图丢了就不可复现
assets/ranks/
promo/rank_src/
# 段位卡的生图中间产物与原始大图（_pixel3 / _pixel4 两批试验图）
promo/_pixel*/
promo/_fonts/
promo/_rank_ref/
# 像素比对脚本（mp_kline_compare.py）生成的临时对照页，可随时重跑
promo/_*.html
# 内部商业/技术规划文档（含策略信息，不入公开仓库）
健身交易员-*.md
