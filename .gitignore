# 数据工程源码（非站点运行时所需，仅本地构建 foods.json 用）
build/
*.pyc
__pycache__/

# 依赖
node_modules/

# 本地环境 / 编辑器
.workbuddy/
.vscode/

# 日志
*.log
_demo.html
promo/raw_*.png
promo/_edgeprofile*/
# 状态迁移回归测试的中间产物（state_test.py 生成，无需入库）
promo/_*.js
# 调试/清理用的临时脚本（一次性的像素水印清理、核验脚本等，不入仓）
promo/_*.py
promo/_*.css
promo/_*.txt
# 端到端验收测试的临时页与浏览器 profile（e2e_test.py 生成）
_e2e.html
promo/_e2eprofile*/
# 小程序调试用的本机中间产物（开发者工具 asar 抽取物 / 其缓存快照 / 探针回滚快照）
# 都是一次性、可再生、且体积大（_cache_backup 约 1 MB），不入仓
promo/_asar/
promo/_cache_backup/
promo/_probe_backup/
# 宣传图/截图成品与可再生的中间数据（体积大，随时可用脚本重跑）
promo/*.png
promo/*.json
# 对拍用的截图与对照页（随时可用 mp_auto_shot.js / mp_rect_*.py 重跑）
promo/_shots/
# 段位卡素材（v2.7.60 定稿，**已入库**）：
#   promo/rank_src/         Mak 外部出图的 10 张原始 PNG（丢了不可复现，必须留）
#   assets/ranks/           运行时 3x WebP（PWA 卡廊 + 小程序云存储上传源）
#   小程序 images/ranks/    2.5x（420×600）兜底图，共 444KB（进主包，保证秒开）
# 三处都由 promo/build_rank_assets.py 从源图重跑 ⇒ 想改尺寸/质量别手改素材。
# 段位卡的生图中间产物与原始大图（_pixel3 / _pixel4 两批试验图）
promo/_pixel*/
promo/_fonts/
promo/_rank_ref/
# 像素比对脚本（mp_kline_compare.py）生成的临时对照页，可随时重跑
promo/_*.html
# 内部商业/技术规划文档（含策略信息，不入公开仓库）
健身交易员-*.md
